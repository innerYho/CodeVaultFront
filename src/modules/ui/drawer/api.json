        "description": "Nombre accesible del panel (p. ej. \"Menú de navegación\")."
      },
      {
        "name": "children",
        "type": "ReactNode",
        "required": true,
        "description": ""
      },
      {
        "name": "side",
        "type": "\"left\" | \"right\"",
        "required": false,
        "default": "\"left\"",
