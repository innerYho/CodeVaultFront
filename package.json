{
  "name": "codevault-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Biblioteca y documentación de módulos de frontend reutilizables (React 19, TypeScript, Tailwind 4, Motion).",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm api && pnpm index && pnpm registry && tsc --noEmit && vite build && node --experimental-strip-types scripts/postbuild.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "api": "node --experimental-strip-types scripts/build-api.ts",
    "registry": "node --experimental-strip-types scripts/build-registry.ts",
    "index": "node --experimental-strip-types scripts/build-index.ts",
    "validate": "node --experimental-strip-types scripts/build-index.ts --check",
    "codevault": "node --experimental-strip-types cli/codevault.ts"
  },
  "dependencies": {
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "codevault": "cli/codevault.ts"
  }
}
